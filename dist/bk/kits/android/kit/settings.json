{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/statusline.cjs"
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "android-emulator": {
      "command": "npx",
      "args": [
        "-y",
        "@androidmcp/server"
      ]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs prompt-context-inject.cjs context-monitor.cjs lint-findings-inject.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs session-init.cjs project-profile.cjs"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/compact-recovery.cjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs global-kill-switch.cjs tool-repetition-detector.cjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs agent-memory-path-guard.cjs fsm-guard.cjs anti-self-implementation.cjs descriptive-name.cjs"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/write-shrink-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs privacy-block.cjs security-check.cjs"
          }
        ]
      },
      {
        "matcher": "Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/scout-block.cjs"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs subagent-live-tracker.cjs context-safety.cjs parallel-safety.cjs delegation-enforcer.cjs traceability-check.cjs budget-guard.cjs subagent-iteration-cap.cjs"
          }
        ]
      },
      {
        "matcher": "mcp_*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/mcp-health-monitor.cjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs checkpoint-save.cjs pattern-extractor.cjs completion-notify.cjs session-cost-rollup.cjs workflow-summary-flush.cjs stop-lint-flush.cjs native-lint-flush.cjs"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs checkpoint-save.cjs handoff-writer.cjs"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs subagent-init.cjs team-context-inject.cjs"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/task-completed-handler.cjs"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/teammate-idle-handler.cjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "planner|bk-planner|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs plan-complete-reminder.cjs complexity-detector.cjs"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs subagent-live-tracker.cjs workflow-metrics.cjs skill-chain-suggest.cjs subagent-cost-capture.cjs decision-tracker.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs no-progress-detector.cjs arch-fitness-android.cjs arch-fitness-android-native.cjs inferential-review.cjs test-generation-hook.cjs ui-snapshot-compare.cjs mutation-testing-sensor.cjs property-based-test-suggester.cjs post-edit-lint.cjs bootstrap-quality-gate.cjs post-edit-simplify.cjs"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bk-dispatch.cjs verify-output.cjs agent-signal-detector.cjs"
          }
        ]
      },
      {
        "matcher": "AskUser.*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/preference-tracker.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/post-commit.cjs"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/token-burn-detector.cjs"
          }
        ]
      }
    ]
  }
}
