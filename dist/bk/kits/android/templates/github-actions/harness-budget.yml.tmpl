# harness-budget.yml — Beer Kit Harness Weekly Cost Budget Trend
# Auto-generated from template: src/templates/github-actions/harness-budget.yml.tmpl
# Copy to .github/workflows/harness-budget.yml in your project.

name: Beer Kit Harness Budget Trend

on:
  schedule:
    # Run every Monday at 08:00 UTC
    - cron: '0 8 * * 1'
  workflow_dispatch:
    inputs:
      issue_number:
        description: 'Issue number to post trend comment (optional)'
        required: false
        type: string

env:
  NODE_VERSION: '18'
  BUDGET_ISSUE_LABEL: 'bk-budget-trend'

jobs:
  budget-trend:
    name: Weekly Cost Trend Report
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Collect cost trend
        id: trend
        run: |
          node .claude/cli/bk-harness-ci/index.cjs \
            --format=json \
            --fail-on=never \
            > harness-budget-report.json
        env:
          BK_PROJECT_ROOT: ${{ github.workspace }}
          BK_HOOK_LOG_DISABLED: '1'
        continue-on-error: true

      - name: Upload budget report
        uses: actions/upload-artifact@v4
        with:
          name: harness-budget-report
          path: harness-budget-report.json
          retention-days: 90

      - name: Post trend to issue
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');

            let report = {};
            try {
              report = JSON.parse(fs.readFileSync('harness-budget-report.json', 'utf8'));
            } catch (e) {
              core.warning('Could not read budget report: ' + e.message);
            }

            const budget = report.budget || {};
            const summary = report.summary || {};
            const date = new Date().toISOString().slice(0, 10);

            const statusIcon = budget.exceeds ? '🔴' : budget.pct >= 80 ? '🟡' : '🟢';
            const body = [
              `## ${statusIcon} Beer Kit Harness Budget Trend — ${date}`,
              '',
              `### Cost Status`,
              `| Metric | Value |`,
              `|--------|-------|`,
              `| PR Budget | $${(budget.budgetUsd || 0).toFixed(2)} |`,
              `| Current Cost | $${(budget.currentUsd || 0).toFixed(4)} |`,
              `| Usage | ${budget.pct || 0}% |`,
              `| Status | ${budget.status || 'unknown'} |`,
              '',
              `### Findings Summary`,
              `| Severity | Count |`,
              `|----------|-------|`,
              `| Errors | ${summary.errors || 0} |`,
              `| Warnings | ${summary.warnings || 0} |`,
              `| Total | ${summary.total || 0} |`,
              '',
              `*Generated by [bk-harness-ci](https://github.com/{{GITHUB_OWNER}}/{{GITHUB_REPO}}) weekly budget check.*`
            ].join('\n');

            // Find or create the budget trend issue
            let issueNumber = context.payload.inputs?.issue_number
              ? parseInt(context.payload.inputs.issue_number)
              : null;

            if (!issueNumber) {
              // Search for open issue with budget label
              const issues = await github.rest.issues.listForRepo({
                owner: context.repo.owner,
                repo: context.repo.repo,
                labels: process.env.BUDGET_ISSUE_LABEL,
                state: 'open',
                per_page: 1
              });

              if (issues.data.length > 0) {
                issueNumber = issues.data[0].number;
              } else {
                // Create a new tracking issue
                const created = await github.rest.issues.create({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  title: 'Beer Kit Harness Budget Trend Tracking',
                  body: 'This issue tracks weekly AI cost budget trends for the bk-harness CI system.',
                  labels: [process.env.BUDGET_ISSUE_LABEL]
                });
                issueNumber = created.data.number;
              }
            }

            await github.rest.issues.createComment({
              issue_number: issueNumber,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body
            });

            core.info(`Posted budget trend to issue #${issueNumber}`);
